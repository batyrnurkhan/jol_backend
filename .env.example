DEBUG=True  # Set to False in production
SECRET_KEY=your_secret_key_here  # Replace with your secret key
DATABASE_NAME=db.sqlite3  # SQLite used in development, can be replaced for production
DATABASE_USER=your_db_user  # Add your database user
DATABASE_PASSWORD=your_db_password  # Add your database password
DATABASE_HOST=localhost
DATABASE_PORT=  # Leave empty or set the appropriate port
